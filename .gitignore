# ============================================================
#  AI Smart Investment Portfolio Advisor — Root .gitignore
# ============================================================

# ──────────────────────────────────────────────
# Python / Backend
# ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
ENV/
env/
.venv/
.env_backup

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
nosetests.xml
coverage.xml
*.cover

# MyPy / type checking
.mypy_cache/
.dmypy.json
dmypy.json

# ──────────────────────────────────────────────
# Node / Frontend
# ──────────────────────────────────────────────
node_modules/
/.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.yarn-integrity

# Build output
frontend/build/
frontend/dist/

# ──────────────────────────────────────────────
# Environment & Secrets  ← NEVER commit these
# ──────────────────────────────────────────────
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
*.pem
*.key
*.cert
*.p12

# ──────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
backend/investment_advisor.db

# ──────────────────────────────────────────────
# Generated / large data files
# ──────────────────────────────────────────────
backend/datasets/investor_risk_dataset.csv
backend/datasets/dataset_report.txt
# Volatility training panel — regenerate with:
#   python -m ml.prepare_volatility_dataset
backend/datasets/volatility_*.parquet
backend/datasets/volatility_report.txt

# Trained ML models
# Artifacts stay local; the repo tracks the training code and the
# contract in backend/app/ml/README.md, not the binaries.
*.pkl
*.joblib
*.h5
*.model

# Cached price history (regenerated on demand from Yahoo Finance)
backend/data_cache/

# Database backups taken before migrations
*.db.backup-*

# ──────────────────────────────────────────────
# Logs
# ──────────────────────────────────────────────
*.log
logs/
log/

# ──────────────────────────────────────────────
# OS & Editor
# ──────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ──────────────────────────────────────────────
# Misc
# ──────────────────────────────────────────────
*.bak
*.tmp
*.temp
