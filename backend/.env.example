# ============================================================
#  Backend Environment Variables — copy to .env and fill in
#  cp .env.example .env
# ============================================================

# ── Database ─────────────────────────────────────────────────
# SQLite (development)
DATABASE_URL=sqlite:///./investment_advisor.db
# PostgreSQL (production) — uncomment and fill in
# DATABASE_URL=postgresql://user:password@localhost:5432/investment_advisor

# ── Security ─────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Application ──────────────────────────────────────────────
APP_NAME=Smart Investment Portfolio Advisor
APP_VERSION=1.0.0
DEBUG=True
API_V1_PREFIX=/api

# ── Ollama AI ─────────────────────────────────────────────────
# Install Ollama: https://ollama.com
# Pull model: ollama pull qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=90
OLLAMA_ENABLED=True

# ── Email (future use) ────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
